{
  "name": "@fizza-hub902/devops-pipeline",
  "version": "1.1.0",
  "description": "Renders the course Markdown sources into HTML pages.",
  "main": "tools/build.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node --test",
    "build": "mkdir -p out && for f in src/*.md; do node tools/build.js \"$f\" \"out/$(basename \"$f\" .md).html\"; done"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bin": {
    "devops-build": "tools/build.js"
  },
  "files": [
    "tools/",
    "README.md"
  ],
  "dependencies": {
    "markdown-it": "^15.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Fizza-hub902/devops_project_27-FYP-211.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
